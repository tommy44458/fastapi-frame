# App
APP_NAME=fastapi-frame
# APP_VERSION 不從環境變數設定 — 版本號由 release 流程寫進 app/config.py
HOST=0.0.0.0
PORT=8000
DEV=false
DEBUG_LOG=false
# 開發環境可開啟自動建表（正式環境請改用 Alembic）
AUTO_CREATE_TABLES=true
CORS_ORIGINS=["*"]

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=fastapi_frame
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET_KEY=please-change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
